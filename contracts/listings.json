{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-finder.local/contracts/listings.json",
  "title": "GET /listings response",
  "description": "Shared contract: FastAPI serves it (pytest), Next.js parses it (vitest).",
  "type": "object",
  "required": ["items", "sort", "live"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/listing" } },
    "sort": { "type": "string", "enum": ["combined", "livability", "deal"] },
    "live": { "type": "boolean" }
  },
  "$defs": {
    "listing": {
      "type": "object",
      "required": ["id", "address", "county", "price", "score_livability", "discount_pct", "reasons"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "address": { "type": "string" },
        "county": { "type": "string" },
        "price": { "type": ["integer", "number"] },
        "price_per_m2": { "type": ["integer", "number", "null"] },
        "rooms": { "type": ["integer", "number", "null"] },
        "area_m2": { "type": ["integer", "number", "null"] },
        "score_livability": { "type": ["integer", "number"] },
        "discount_pct": { "type": ["integer", "number"] },
        "score_combined": { "type": ["integer", "number"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "image_url": { "type": ["string", "null"] },
        "is_live": { "type": "boolean" },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] }
      }
    }
  }
}
